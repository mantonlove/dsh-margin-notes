{
  "name": "dsh-margin-notes",
  "version": "0.1.6",
  "description": "Margin notes for DSH: select text in a document or an assistant reply, jot a note in the margin, collect them, then drop the batch into the composer as one inline annotation chip that expands on send.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "annotation",
    "margin-notes",
    "batch",
    "notes",
    "chat",
    "review",
    "document",
    "deepseek-harness",
    "document-annotation",
    "selection"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "test": "node --test test/contract.test.mjs test/format.test.mjs test/placement.test.mjs"
  },
  "author": "mantonlove (https://github.com/mantonlove)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mantonlove/dsh-margin-notes.git"
  },
  "homepage": "https://github.com/mantonlove/dsh-margin-notes#readme",
  "bugs": {
    "url": "https://github.com/mantonlove/dsh-margin-notes/issues"
  }
}
